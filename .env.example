# ══════════════════════════════════════════════════════════════
#  Настройки геоинтеллектуального сервиса
#  Скопируйте файл в .env и заполните нужные поля
# ══════════════════════════════════════════════════════════════

# ── Выбор ИИ-провайдера ──────────────────────────────────────
# auto   — YandexGPT, если указан ключ/токен, иначе демо-анализатор
# yandex — только YandexGPT (ошибка, если ключей нет)
# demo   — только локальный демо-анализатор (без внешних запросов)
LLM_PROVIDER=auto

# ── Yandex Cloud (YandexGPT) ──────────────────────────────────
# Достаточно ОДНОГО способа аутентификации:
#
# Вариант 1 (рекомендуется): API-ключ, созданный в консоли
# Yandex Cloud → Service YandexGPT → API-ключи
YC_API_KEY=

# Вариант 2: OAuth-токен Яндекс ID — прокси сам обменяет его на
# IAM-токен и будет автоматически обновлять при истечении
# (получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6900344f5e4d9489f2d2b747264f23)
YC_OAUTH_TOKEN=

# Вариант 3: готовый IAM-токен (ВНИМАНИЕ: живёт только 12 часов,
# для лабораторной допустимо, для продакшена — только авто-обновление)
YC_IAM_TOKEN=

# Folder ID каталога Yandex Cloud (обязателен во всех вариантах)
YC_FOLDER_ID=

# Модель: yandexgpt-lite (быстрая) или yandexgpt (точнее)
YC_MODEL=yandexgpt-lite

# ── Яндекс.Карты (русские карты, опционально) ────────────────
# API-ключ из кабинета разработчика Яндекс (https://developer.tech.yandex.ru/).
# Если не указан, используется OpenStreetMap (без ключа).
YANDEX_MAPS_API_KEY=

# ── Сервер ────────────────────────────────────────────────────
PORT=3000
